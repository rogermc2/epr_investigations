\begin_layout Subsection
Derivation of the Theoretical Inequality
\begin_inset CommandInset label
LatexCommand label
name "subsec:Derivation-of-Bell-inequality"

\end_inset


\end_layout

\begin_layout Standard
Reproduce Freedman's derivation in terms of 
\backslash
(P_{++}
\backslash
) and the marginal probabilities.
\end_layout

\begin_layout Standard
Freedman's commences his derivation of inequalities 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:FII.8"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

 
\begin_inset CommandInset citation
LatexCommand cite
after "inequality (II.8)"
key "Freedman1972"
literal "false"

\end_inset

 by defining a correlation function 
\begin_inset Formula $P\left(\hat{a},\hat{b}\right)$
\end_inset

 
\begin_inset CommandInset citation
LatexCommand cite
after "equation (II.2)"
key "Freedman1972"
literal "false"

\end_inset

:
\begin_inset Formula 
\begin{eqnarray}
P\left(\hat{a},\hat{b}\right) & = & \int\rho\left(\lambda\right)A\left(\hat{a},\lambda\right)B\left(\hat{b},\lambda\right)d\lambda\label{eq:FII.2}
\end{eqnarray}

\end_inset


\end_layout

\begin_layout Standard
Then he introduces two additional measurement parameters 
\begin_inset Formula $\hat{c}$
\end_inset

 and 
\begin_inset Formula $\hat{d}$
\end_inset

,
 based on equation 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:FII.2"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

,
 defining:
\begin_inset Formula 
\begin{eqnarray}
\left|P\left(\hat{a},\hat{b}\right)-P\left(\hat{a},\hat{c}\right)\right| & = & \left|\int\rho\left(\lambda\right)A\left(\hat{a},\lambda\right)B\left(\hat{b},\lambda\right)d\lambda-\int\rho\left(\lambda\right)A\left(\hat{a},\lambda\right)B\left(\hat{c},\lambda\right)d\lambda\right|\\
 & = & \Big|\int\rho\left(\lambda\right)A\left(\hat{a},\lambda\right)B\left(\hat{b},\lambda\right)\left[1\pm A\left(\hat{d},\lambda\right)B\left(\hat{c},\lambda\right)\right]d\lambda\\
 &  & -\int\rho\left(\lambda\right)A\left(\hat{a},\lambda\right)B\left(\hat{c},\lambda\right)\left[1\pm A\left(\hat{d},\lambda\right)B\left(\hat{b},\lambda\right)\right]d\lambda\Big|\\
 & \leq & \int\rho\left(\lambda\right)\left|A\left(\hat{a},\lambda\right)B\left(\hat{b},\lambda\right)\right|\left|1\pm A\left(\hat{d},\lambda\right)B\left(\hat{c},\lambda\right)\right|d\lambda\\
 &  & +\int\rho\left(\lambda\right)\left|A\left(\hat{a},\lambda\right)B\left(\hat{c},\lambda\right)\right|\left|1\pm A\left(\hat{d},\lambda\right)B\left(\hat{b},\lambda\right)\right|d\lambda
\end{eqnarray}

\end_inset

Therefore:
\begin_inset Formula 
\begin{eqnarray}
\left|P\left(\hat{a},\hat{b}\right)-P\left(\hat{a},\hat{c}\right)\right| & \leq & 2\int\rho\left(\lambda\right)d\lambda\\
 &  & \pm\left(\int\rho\left(\lambda\right)A\left(\hat{d},\lambda\right)B\left(\hat{c},\lambda\right)d\lambda+\int\rho\left(\lambda\right)A\left(\hat{d},\lambda\right)B\left(\hat{b},\lambda\right)\right)\\
\therefore\left|P\left(\hat{a},\hat{b}\right)-P\left(\hat{a},\hat{c}\right)\right| & \leq & 2+\left[P\left(\hat{d},\hat{c}\right)-P\left(\hat{d},\hat{b}\right)\right]
\end{eqnarray}

\end_inset

which can be written as 
\begin_inset CommandInset citation
LatexCommand cite
after "equation (II.4)"
key "Freedman1972"
literal "false"

\end_inset

:
\begin_inset Formula 
\begin{eqnarray}
-2\leq & P\left(\hat{a},\hat{b}\right)-P\left(\hat{a},\hat{c}\right)+P\left(\hat{d},\hat{c}\right)+P\left(\hat{d},\hat{b}\right) & \leq2\label{eq:FII.4}
\end{eqnarray}

\end_inset

Freedman states that the inequalities 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:FII.4"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

 are quite general;
 in particular,
 the source of the particle pairs and the exact nature of the measurements are not specified.
 However,
 the nature of the measurements are specifically specified by the definitions 
\begin_inset Formula $A\left(\hat{a},\lambda\right)=\pm1$
\end_inset

 and 
\begin_inset Formula $B\left(\hat{b},\lambda\right)=\pm1$
\end_inset

.
 They certainly are not of the form 
\begin_inset Formula $\hat{a}\cdot\overrightarrow{\sigma_{1}}$
\end_inset

 and 
\begin_inset Formula $\hat{b}\cdot\overrightarrow{\sigma_{2}}$
\end_inset

;
 nor are they of the form of coincidence count measurements.
\end_layout

\begin_layout Standard
To express the inequalities 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:FII.4"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

 in terms of directly measurable quantities the following partition of 
\begin_inset Formula $\Gamma$
\end_inset

 is defined by:
\begin_inset Formula 
\begin{eqnarray}
\Gamma_{ij}\left(\hat{a},\hat{b}\right) & = & \left\{ A\left(\hat{a},\lambda\right)=i\,and\,B\left(\hat{b},\lambda\right)\right\} 
\end{eqnarray}

\end_inset

where:
\end_layout

\begin_layout Standard
\begin_inset Formula $i=\pm1$
\end_inset

 and 
\begin_inset Formula $j=\pm1$
\end_inset

.
\end_layout

\begin_layout Standard
Freedman uses this partition,
 we define the following quantities:
\begin_inset Formula 
\begin{eqnarray}
P_{ij}\left(\hat{a},\hat{b}\right) & = & \int_{\Gamma_{ij}\left(\hat{a},\hat{b}\right)}\rho\left(\lambda\right)d\lambda
\end{eqnarray}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $P_{++}\left(\hat{a},\hat{b}\right)$
\end_inset

 is defined as the probability of joint passage of the photons through the polarizers.
\end_layout

\begin_layout Standard
Using 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:FII.2"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

 and the normalization condition 
\begin_inset Formula $\int\rho\left(\lambda\right)d\lambda$
\end_inset

 yields:
\begin_inset Formula 
\begin{eqnarray}
P\left(\hat{a},\hat{b}\right) & = & P_{++}\left(\hat{a},\hat{b}\right)-P_{+-}\left(\hat{a},\hat{b}\right)-P_{-+}\left(\hat{a},\hat{b}\right)+P_{--}\left(\hat{a},\hat{b}\right)\\
1 & = & P_{++}\left(\hat{a},\hat{b}\right)+P_{+-}\left(\hat{a},\hat{b}\right)+P_{-+}\left(\hat{a},\hat{b}\right)+P_{--}\left(\hat{a},\hat{b}\right)
\end{eqnarray}

\end_inset


\end_layout

\begin_layout Standard
Define:
\begin_inset Formula 
\begin{eqnarray}
P_{1}\left(\hat{a}\right) & = & P_{++}\left(\hat{a},\hat{b}\right)+P_{+-}\left(\hat{a},\hat{b}\right)\\
P_{2}\left(\hat{b}\right) & = & P_{++}\left(\hat{a},\hat{b}\right)+P_{-+}\left(\hat{a},\hat{b}\right)
\end{eqnarray}

\end_inset

where 
\begin_inset Formula $P_{1}\left(\hat{a}\right)$
\end_inset

 and 
\begin_inset Formula $P_{2}\left(\hat{b}\right)$
\end_inset

 are the probabilities of joint passage when one of the polarizers is absent.
\end_layout

\begin_layout Standard
Expressing the correlation function in terms of the probabilities of joint passage 
\begin_inset CommandInset citation
LatexCommand cite
after "equation (II.5)"
key "Freedman1972"
literal "false"

\end_inset

:
\begin_inset Formula 
\begin{eqnarray}
P\left(\hat{a},\hat{b}\right) & = & 4P_{++}\left(\hat{a},\hat{b}\right)-2P_{1}\left(\hat{a}\right)-P_{2}\left(\hat{b}\right)+1\label{eq:FII.5}
\end{eqnarray}

\end_inset

Substitution equation 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:FII.5"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

 into the inequalities 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:FII.4"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

 
\begin_inset CommandInset citation
LatexCommand cite
after "equation (II.6)"
key "Freedman1972"
literal "false"

\end_inset

:
\begin_inset Formula 
\begin{eqnarray}
-2\leq & P_{++}\left(\hat{a},\hat{b}\right)+P_{++}\left(\hat{d},\hat{c}\right)+P_{++}\left(\hat{d},\hat{b}\right)-P_{1}\left(\hat{d}\right)-P_{2}\left(\hat{b}\right) & \leq2\label{eq:FII.6}
\end{eqnarray}

\end_inset


\end_layout

\begin_layout Subsection
Application to Experimental Measurements
\end_layout

\begin_layout Standard
Having derived the inequality in terms of theoretical probabilities,
 Freedman then expresses equation 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:FII.6"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

 in terms of experimentally measured coincidence-rate ratios.
 
\end_layout

\begin_layout Standard
In the experiment under consideration the efficiencies of the detectors are less than 30% so all transmitted photons are not detected and the probabilities of joint passage to experimental count rates involves an additional assumption that the detection probability for a photon is independent of whether or not the photon has passed through a polarizer.The following equations reproduce this step in his derivation,
 using the notation of the original thesis.
\end_layout

\begin_layout Standard
For this experiment 
\begin_inset Formula $R_{1}\left(\hat{a}\right)$
\end_inset

 and 
\begin_inset Formula $R_{2}\left(\hat{b}\right)$
\end_inset

 are independent of 
\begin_inset Formula $\hat{a}$
\end_inset

 and 
\begin_inset Formula $\hat{b}$
\end_inset

 and 
\begin_inset Formula $R\left(\hat{a},\hat{b}\right)$
\end_inset

 depends only on 
\begin_inset Formula $\hat{a}\cdot\hat{b}$
\end_inset

 
\begin_inset CommandInset citation
LatexCommand cite
after "equation (II.8)"
key "Freedman1972"
literal "false"

\end_inset

:
\begin_inset Formula 
\begin{eqnarray}
-1\leq & \frac{R\left(\phi_{1}\right)}{R_{0}}-\frac{R\left(\phi_{1}+\phi_{2}+\phi_{3}\right)}{R_{0}}+\frac{R\left(\phi_{2}\right)}{R_{0}}+\frac{R\left(\phi_{3}\right)}{R_{0}}-\frac{R_{1}}{R_{0}}-\frac{R_{2}}{R_{0}} & \leq0\label{eq:FII.8-1}
\end{eqnarray}

\end_inset


\end_layout

\begin_layout Standard
where:
\begin_inset Formula 
\begin{eqnarray}
\phi_{1} & = & cos^{-1}\left(\hat{a},\hat{b}\right)\\
\phi_{2} & = & cos^{-1}\left(\hat{d},\hat{c}\right)\\
\phi_{3} & = & cos^{-1}\left(\hat{d},\hat{b}\right)
\end{eqnarray}

\end_inset


\begin_inset Formula 
\begin{eqnarray}
\phi_{1}+\phi_{2}+\phi_{3} & = & cos^{-1}\left(\hat{a},\hat{c}\right)
\end{eqnarray}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $R\left(\phi_{i}\right)$
\end_inset

 represents the coincidence rate with both polarizers in place.
\end_layout

\begin_layout Standard
\begin_inset Formula $R_{0}$
\end_inset

 represents the coincidence rate with both polarizers removed.
\end_layout

\begin_layout Standard
\begin_inset Formula $R_{1}$
\end_inset

 represents the coincidence rate with polarizer 2 removed.
\end_layout

\begin_layout Standard
\begin_inset Formula $R_{2}$
\end_inset

 represents the coincidence rate with polarizer 1 removed.
\end_layout

