\begin_inset Formula 
\begin{eqnarray}
S\left(\phi_{1},\phi_{2},\phi_{3}\right) & \equiv & \frac{R\left(\phi_{1}\right)}{R_{0}}-\frac{R\left(\phi_{1}+\phi_{2}+\phi_{3}\right)}{R_{0}}+\frac{R\left(\phi_{2}\right)}{R_{0}}+\frac{R\left(\phi_{3}\right)}{R_{0}}-\frac{R_{1}}{R_{0}}-\frac{R_{2}}{R_{0}}\label{eq:FII.8}
\end{eqnarray}

\end_inset


\begin_inset Formula 
\begin{eqnarray}
\frac{R\left(\phi\right)}{R_{0}} & = & A+BCos\left(2\phi\right)\label{eq:FII.10}\\
\frac{R_{1}}{R_{0}} & = & \frac{1}{2}\left(\varepsilon^{1}_{M}+\varepsilon^{1}_{m}\right)\label{eq:FII.11a}\\
\frac{R_{2}}{R_{0}} & = & \frac{1}{2}\left(\varepsilon^{2}_{M}+\varepsilon^{2}_{m}\right)\label{eq:FII.11b}
\end{eqnarray}

\end_inset

where:
\begin_inset Formula 
\begin{eqnarray}
A & = & \frac{1}{4}\left(\varepsilon^{1}_{M}+\varepsilon^{1}_{m}\right)\left(\varepsilon^{2}_{M}+\varepsilon^{2}_{m}\right)\\
B & = & \frac{1}{4}\left(\varepsilon^{1}_{M}-\varepsilon^{1}_{m}\right)\left(\varepsilon^{2}_{M}-\varepsilon^{2}_{m}\right)
\end{eqnarray}

\end_inset


\begin_inset Formula 
\begin{eqnarray}
S\left(\phi_{1},\phi_{2},\phi_{3}\right) & = & A+BCos\left(2\phi_{1}\right)+A+BCos\left(2\left(\phi_{1}+\phi_{2}+\phi_{3}\right)\right)+A+BCos\left(2\phi_{3}\right)-\frac{R_{1}}{R_{0}}-\frac{R_{2}}{R_{0}}\\
 & = & 3A+B\left(Cos\left(2\phi_{1}\right)+Cos\left(2\left(\phi_{1}+\phi_{2}+\phi_{3}\right)\right)+Cos\left(2\phi_{3}\right)\right)-\frac{R_{1}}{R_{0}}-\frac{R_{2}}{R_{0}}
\end{eqnarray}

\end_inset


