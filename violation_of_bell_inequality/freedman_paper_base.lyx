after "equation (I.2)"
key "Freedman1972"
literal "false"

\end_inset

:
\begin_inset Formula 
\begin{eqnarray}
E\left(\hat{a},\hat{b}\right) & = & \left\langle \psi\left|\hat{a}\cdot\overrightarrow{\sigma_{1}}\,\hat{b}\cdot\overrightarrow{\sigma_{2}}\right|\psi\right\rangle =-\hat{a}\cdot\hat{b}\label{eq:FI.2}
\end{eqnarray}

\end_inset


\end_layout

\begin_layout Standard
The expectation value for the product of two individual spin measurements 
\begin_inset Formula $A\left(\hat{a},\lambda_{1}\right)B\left(\hat{b},\lambda_{2}\right)=\pm1$
\end_inset

 in the directions 
\begin_inset Formula $\hat{a}$
\end_inset

 and 
\begin_inset Formula $\hat{b}$
\end_inset

 is actually given by
\begin_inset CommandInset citation
LatexCommand cite
after "equation (I.3)"
key "Freedman1972"
literal "false"

\end_inset

:
\begin_inset Formula 
\begin{eqnarray}
E\left(\hat{a},\hat{b}\right) & = & \intop_{\Lambda}\rho\left(\lambda\right)A\left(\hat{a},\lambda_{1}\right)B\left(\hat{b},\lambda_{2}\right)d\lambda\label{eq:FI.3  FII.2}
\end{eqnarray}

\end_inset


\end_layout

