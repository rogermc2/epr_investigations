\begin_layout Title
Freedman Inequality Versus Prediction Analysis
\end_layout

\begin_layout Standard
Prediction:
\begin_inset Formula 
\begin{eqnarray}
\frac{R(\phi)}{R_{0}} & = & \frac{1}{4}\left\{ (\epsilon^{1}_{1}+\epsilon^{2}_{1})(\epsilon^{1}_{2}+\epsilon^{2}_{2})+(\epsilon^{1}_{1}-\epsilon^{2}_{1})(\epsilon^{1}_{2}-\epsilon^{2}_{2})F(0)\cos(2\phi)\right\} 
\end{eqnarray}

\end_inset


\end_layout

\begin_layout Standard
where:
\end_layout

\begin_layout Standard
• 
\begin_inset Formula $R(\phi)$
\end_inset

 represents the integrated coincidence count rate at relative polarizer alignment 
\begin_inset Formula $\phi=\vert a-b\vert$
\end_inset

.
\end_layout

\begin_layout Standard
• 
\begin_inset Formula $R_{0}$
\end_inset

 represents the baseline reference rate measured with both polarizing plates physically removed from the optical paths.
\end_layout

\begin_layout Standard
• 
\begin_inset Formula $\epsilon_{1},\epsilon_{2}$
\end_inset

 represents laboratory calibration constants for polarizer maximum transmittance and minimum leakage.
\end_layout

\begin_layout Itemize
\begin_inset Formula $F\left(0\right)$
\end_inset

 represents a factor that accounts for the finite solid detection angle.
\end_layout

\begin_layout Standard
Inequality:
\begin_inset Formula 
\begin{eqnarray}
-1\leq & \frac{R\left(\phi_{1}\right)}{R_{0}}-\frac{R\left(\phi_{1}+\phi_{2}+\phi_{3}\right)}{R_{0}}+\frac{R\left(\phi_{2}\right)}{R_{0}}+\frac{R\left(\phi_{3}\right)}{R_{0}}-\frac{R_{1}}{R_{0}}-\frac{R_{2}}{R_{0}} & \leq0\label{eq:FII.8}
\end{eqnarray}

\end_inset


\end_layout

\begin_layout Standard
where:
\begin_inset Formula 
\begin{eqnarray}
\phi_{1} & = & cos^{-1}\left(\overrightarrow{a},\overrightarrow{b}\right)\\
\phi_{2} & = & cos^{-1}\left(\overrightarrow{d},\overrightarrow{c}\right)\\
\phi_{3} & = & cos^{-1}\left(\overrightarrow{d}\overrightarrow{b}\right)
\end{eqnarray}

\end_inset


\begin_inset Formula 
\begin{eqnarray}
\phi_{1}+\phi_{2}+\phi_{3} & = & cos^{-1}\left(\overrightarrow{a},\overrightarrow{c}\right)
\end{eqnarray}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $R\left(\phi_{i}\right)$
\end_inset

 represents the coincidence rate with both polarizers in place.
\end_layout

\begin_layout Standard
\begin_inset Formula $R_{0}$
\end_inset

 represents the coincidence rate with both polarizers removed.
\end_layout

\begin_layout Standard
\begin_inset Formula $R_{1}$
\end_inset

 represents the coincidence rate with polarizer 2 removed.
\end_layout

\begin_layout Standard
\begin_inset Formula $R_{2}$
\end_inset

 represents the coincidence rate with polarizer 1 removed.
\end_layout

\begin_layout Standard
Inequalities II.8 refer directly to the measured coincidence rates.
\end_layout

\begin_layout Standard
Prediction 
\begin_inset Formula $\frac{R(\phi)}{R_{0}}$
\end_inset

 is a function of 
\begin_inset Formula $\phi$
\end_inset

,
 the difference between two polarizer settings whereas the inequalty 
