with "config/freedman_ada_config.gpr";
project Freedman_Ada is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Freedman_Ada_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use ".";
   for Main use ("freedman.adb");

   package Compiler is
      for Default_Switches ("Ada") use Freedman_Ada_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Freedman_Ada;
