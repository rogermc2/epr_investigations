with "config/analyze_sync_config.gpr";
project Analyze_Sync is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Analyze_Sync_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use ".";
   for Main use ("analyze_sync.adb");

   package Compiler is
      for Default_Switches ("Ada") use Analyze_Sync_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Analyze_Sync;
