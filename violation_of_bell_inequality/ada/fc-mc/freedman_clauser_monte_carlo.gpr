
project Freedman_Clauser_Monte_Carlo is

   for Languages use ("Ada");
   for Source_Dirs use ("src", "../common");
   for Object_Dir use "obj";
   for Exec_Dir use ".";
   for Main use ("fc_monte_carlo.adb");

   package Naming is
      for Spec_Suffix ("Ada") use ".ads";
      for Body_Suffix ("Ada") use ".adb";
   end Naming;

   package Compiler is
      for Switches ("ada") use ("-gnatw.ufkpru", "-gnatybcdefux");
   end Compiler;

end Freedman_Clauser_Monte_Carlo;

