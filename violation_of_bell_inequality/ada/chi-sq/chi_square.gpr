
project Chi_Square is

   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use ".";
   for Main use ("chi_square_test.adb");

   package Naming is
      for Spec_Suffix ("Ada") use ".ads";
      for Body_Suffix ("Ada") use ".adb";
   end Naming;

   package Compiler is
      for Switches ("ada") use ("-gnatw.ufkpru", "-gnatybcdefux");
   end Compiler;

end Chi_Square;

