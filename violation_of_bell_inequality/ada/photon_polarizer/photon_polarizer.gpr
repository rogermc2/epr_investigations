with "config/photon_polarizer_config.gpr";
project Photon_Polarizer is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Photon_Polarizer_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use ".";
   for Main use ("polarize.adb");

   package Compiler is
      for Default_Switches ("Ada") use Photon_Polarizer_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Photon_Polarizer;
