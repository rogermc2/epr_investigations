\end_layout

\begin_layout LyX-Code
T_Plate_P := ((1.0 - Rp) / (1.0 + Rp)) * Attenuation;
\end_layout

\begin_layout LyX-Code
T_Plate_S := ((1.0 - Rs) / (1.0 + Rs)) * Attenuation;
\end_layout

\begin_layout LyX-Code
