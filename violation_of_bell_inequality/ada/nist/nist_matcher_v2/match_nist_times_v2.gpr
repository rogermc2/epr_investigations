
project Match_NIST_Times_V2 is

   for Languages use ("Ada");
   for Source_Dirs use ("src", "../../common", "../nist_common");
   for Object_Dir use "obj";
   for Exec_Dir use ".";
   for Main use ("match.adb");

   package Naming is
      for Spec_Suffix ("Ada") use ".ads";
      for Body_Suffix ("Ada") use ".adb";
   end Naming;

   package Compiler is
      for Switches ("ada") use ("-gnatw.ufkpru", "-gnatybcdefux", "-gnat2022");
   end Compiler;

end Match_NIST_Times_V2;

